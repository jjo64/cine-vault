# Configuración del servidor
PORT=4000
FRONTEND_URL=http://localhost:5000

# API de TMDB (Obtén tu propia key en themoviedb.org)
API_KEY_TMDB=tu_api_key_aqui

# Base de Datos (MySQL/MariaDB)
# Ajusta estos valores con los de tu XAMPP o base de datos local
DATABASE_URL="mysql://root:password@localhost:3306/cinevault"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="cinevault"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# Seguridad — Tokens JWT
# Pon cualquier palabra secreta aquí para que el login funcione
JWT_SECRET="una_palabra_secreta_muy_larga"
REFRESH_SECRET="otra_palabra_secreta_diferente"

# Redis (Opcional para seguridad, si no lo tienes usará los valores por defecto)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Stripe (Opcional, para pagos)
# STRIPE_SECRET_KEY=sk_test_tu_clave_aqui
