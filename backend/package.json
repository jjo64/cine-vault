{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend-cinevault",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--loader ts-node/esm --no-warnings\" nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "node --watch index.js",
    "kill-node": "taskkill /F /IM node.exe /T || exit 0",
    "stop": "npm run kill-node",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "author": "nati, jolina, jo",
  "license": "ISC",
  "devDependencies": {
    "@prisma/client": "^7.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.10",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "dotenv": "^17.2.4",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "ts-node": "10.9.2"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.3.0",
    "@types/node": "^25.0.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.4.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "p-map": "^4.0.0",
    "stripe": "^20.3.1",
    "zod": "4.3.6"
  }
}
